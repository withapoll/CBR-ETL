# Скопируй этот файл в .env — для локального запуска значения уже рабочие.
# Логин и пароль — от контейнера из docker-compose.yml. Это не секрет:
# одноразовая локальная база. Настоящие секреты в этот файл не кладут.
PG_DSN=postgresql://postgres:dev_local_only@localhost:5433/cbrdb?connect_timeout=5

HTTP_TIMEOUT=10
RETRIES=3
BACKOFF_BASE=2
PAUSE_BETWEEN_DAYS=0.3
LOG_LEVEL=INFO

# Отдельная база для интеграционных тестов: тесты создают её сами.
# В имени обязательно слово test — иначе тесты откажутся работать.
TEST_PG_DSN=postgresql://postgres:dev_local_only@localhost:5433/cbr_test?connect_timeout=5
